DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/geolearn_ai
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Development defaults. For production use ENVIRONMENT=production and DB_STARTUP_STRICT=true.
ENVIRONMENT=development
DB_STARTUP_STRICT=false
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
CLERK_JWT_AUDIENCE=your_clerk_jwt_audience
CLERK_JWKS_CACHE_TTL_SECONDS=900
CLERK_JWKS_STALE_WHILE_REVALIDATE_SECONDS=60
TUTOR_RATE_LIMIT_MAX_REQUESTS=10
TUTOR_RATE_LIMIT_WINDOW_SECONDS=60
SESSIONS_RATE_LIMIT_MAX_REQUESTS=60
SESSIONS_RATE_LIMIT_WINDOW_SECONDS=60
YOUTUBE_RATE_LIMIT_MAX_REQUESTS=20
YOUTUBE_RATE_LIMIT_WINDOW_SECONDS=60
CODE_RATE_LIMIT_MAX_REQUESTS=5
CODE_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=redis://localhost:6379/0

# Development default. For production use RATE_LIMIT_REDIS_STRICT=true.
RATE_LIMIT_REDIS_STRICT=false
REDIS_TUTOR_RATE_LIMIT_PREFIX=ratelimit:tutor
REDIS_SESSIONS_RATE_LIMIT_PREFIX=ratelimit:sessions
REDIS_YOUTUBE_RATE_LIMIT_PREFIX=ratelimit:youtube
REDIS_CODE_RATE_LIMIT_PREFIX=ratelimit:code
DEEPSEEK_API_KEY=your_deepseek_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
